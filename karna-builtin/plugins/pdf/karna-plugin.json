{
  "schema_version": 1,
  "id": "karna.pdf",
  "name": "PDF",
  "version": "1.0.0",
  "publisher": {
    "id": "karna",
    "name": "Karna"
  },
  "description": "Read, extract, OCR, create, merge, split, and render PDF documents with verification",
  "license": {
    "spdx": "MIT",
    "file": "LICENSE"
  },
  "interface": {
    "category": "documents",
    "icon": "assets/icon.png",
    "capabilities": ["read", "write", "interactive"]
  },
  "compatibility": {
    "karna": ">=0.18.0",
    "platforms": ["win32-x64", "darwin-x64", "darwin-arm64", "linux-x64"]
  },
  "entrypoints": {
    "skills": ["skills/"],
    "mcp": []
  },
  "permissions": [
    "filesystem:project",
    "filesystem:read",
    "filesystem:write"
  ],
  "dependencies": {
    "python": ["pypdf", "pdf2image", "pytesseract"]
  }
}
