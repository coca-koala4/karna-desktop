# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public URL (used for status endpoint)
KARNA_RELAY_PUBLIC_URL=ws://localhost:3000

# Redis connection URL
KARNA_RELAY_REDIS_URL=redis://localhost:6379

# TLS mode: off, terminus, passthrough
KARNA_RELAY_TLS_MODE=off

# Envelope TTL in hours (default: 24)
KARNA_RELAY_ENVELOPE_TTL=24

# Rate limit: max_requests:window_seconds (default: 60:60)
KARNA_RELAY_RATE_LIMIT=60:60

# CORS allowed origins, comma-separated (default: *)
KARNA_RELAY_CORS_ORIGINS=*
